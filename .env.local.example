# ============================================================
# MUNDIAL 2026 — Variables de entorno (EJEMPLO — no commitear .env.local)
# ============================================================

# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Nuevo formato Supabase (Settings → API Keys → Publishable and secret API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Football-Data.org (obtén tu key gratis en football-data.org)
FOOTBALL_DATA_API_KEY=tu-api-key-aqui

# API-Football via RapidAPI (backup, opcional)
RAPIDAPI_KEY=tu-rapidapi-key-aqui

# VAPID Keys para Web Push
# Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=tu-vapid-public-key
VAPID_PRIVATE_KEY=tu-vapid-private-key
VAPID_CONTACT_EMAIL=tu@email.com

# Cron secret (genera con: openssl rand -hex 32)
CRON_SECRET=tu-cron-secret-aqui
